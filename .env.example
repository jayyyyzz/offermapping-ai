# OpenAI-compatible extraction model (temperature 0)
# You can either fill the direct values below, or set EXTRACTOR_PROFILE to
# a profile from backend/models.json (copy backend/models.example.json first).
EXTRACTOR_PROFILE=
EXTRACTOR_BASE_URL=https://api.example.com/v1
EXTRACTOR_API_KEY=
EXTRACTOR_MODEL=

# OpenAI-compatible generation model (temperature 0.3)
GENERATOR_PROFILE=
GENERATOR_BASE_URL=https://api.example.com/v1
GENERATOR_API_KEY=
GENERATOR_MODEL=

# Optional JuAIAPI compatible gateway profiles from backend/models.example.json
CLAUDE_JUAIAPI_API_KEY=
CODEX_JUAIAPI_API_KEY=

# Optional offline judges for the later model evaluation harness
JUDGE_A_BASE_URL=
JUDGE_A_PROFILE=
JUDGE_A_API_KEY=
JUDGE_A_MODEL=
JUDGE_B_BASE_URL=
JUDGE_B_PROFILE=
JUDGE_B_API_KEY=
JUDGE_B_MODEL=

# Runtime. Set APP_ENV=production only after replacing TOKEN_SECRET.
APP_ENV=development
TOKEN_SECRET=replace-with-a-long-random-secret
ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
OFFERMAPPING_DB=backend/offermapping.db
MODEL_REGISTRY_PATH=backend/models.json
# Some compatible gateways restrict client identifiers; set this only if your gateway documents an allowed value.
MODEL_USER_AGENT=OfferMapping-Backend/0.2

# Single-instance demo protection. Use Redis or an API gateway when scaling to
# multiple backend replicas.
RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT=10
REGISTER_RATE_LIMIT=5
ANALYSIS_RATE_LIMIT=10
DOCUMENT_RATE_LIMIT=20
EVENT_RATE_LIMIT=60
FEEDBACK_RATE_LIMIT=20
COST_WINDOW_SECONDS=86400
ANALYSIS_COST_CHAR_LIMIT=300000
MODEL_MAX_OUTPUT_TOKENS=1800
