{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offermapping.local/schemas/eval-case.schema.json",
  "title": "OfferMapping evaluation case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "dataset_version",
    "split",
    "synthetic",
    "case_type",
    "title",
    "job_family",
    "subtrack",
    "difficulty",
    "jd",
    "resume",
    "gold",
    "generation_expectations",
    "tags"
  ],
  "properties": {
    "case_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "dataset_version": { "const": "smoke-v1.2" },
    "split": { "const": "smoke" },
    "synthetic": { "const": true },
    "case_type": { "enum": ["realistic", "boundary"] },
    "title": { "type": "string", "minLength": 4 },
    "job_family": { "const": "ai_app_dev" },
    "subtrack": {
      "enum": ["rag", "agent", "llm_backend", "ai_workflow", "model_evaluation", "deployment"]
    },
    "difficulty": { "enum": ["entry", "junior", "mid"] },
    "jd": { "type": "string", "minLength": 80, "maxLength": 8000 },
    "resume": { "type": "string", "minLength": 100, "maxLength": 10000 },
    "gold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "job_family", "hard_requirements", "background_assets", "skills"],
      "properties": {
        "role": { "type": "string" },
        "job_family": { "const": "ai_app_dev" },
        "hard_requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "jd_quote", "resume_quote", "status"],
            "properties": {
              "type": { "enum": ["education", "major", "years", "certificate", "location", "schedule", "other"] },
              "jd_quote": { "type": "string", "minLength": 1 },
              "resume_quote": { "type": "string" },
              "status": { "enum": ["met", "unmet", "unknown"] }
            }
          }
        },
        "background_assets": {
          "type": "array",
          "items": { "type": "string", "minLength": 2 },
          "minItems": 1
        },
        "skills": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "name", "priority", "jd_quote", "resume_quote", "evidence"],
            "properties": {
              "key": { "type": "string", "pattern": "^[a-z0-9_]+$" },
              "name": { "type": "string" },
              "priority": { "enum": ["must", "nice"] },
              "jd_quote": { "type": "string", "minLength": 1 },
              "resume_quote": { "type": "string" },
              "evidence": { "enum": ["project-backed", "listed-only", "missing"] }
            }
          }
        }
      }
    },
    "generation_expectations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_focus_skill_keys", "must_use_background_assets", "forbid_unsupported_metrics", "notes"],
      "properties": {
        "required_focus_skill_keys": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "must_use_background_assets": { "type": "array", "items": { "type": "string" } },
        "forbid_unsupported_metrics": { "const": true },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "tags": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
