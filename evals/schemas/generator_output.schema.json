{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offermapping.local/schemas/generator-output.schema.json",
  "title": "OfferMapping generator output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "diagnosis",
    "main_project_id",
    "project_title",
    "project_rationale",
    "resume_line",
    "recommendations",
    "milestones"
  ],
  "properties": {
    "diagnosis": { "type": "string", "minLength": 20, "maxLength": 800 },
    "main_project_id": { "type": "string", "minLength": 1 },
    "project_title": { "type": "string", "minLength": 4, "maxLength": 120 },
    "project_rationale": { "type": "string", "minLength": 20, "maxLength": 800 },
    "resume_line": { "type": "string", "minLength": 20, "maxLength": 800 },
    "recommendations": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["project_id", "reason", "matched_gaps", "adaptation", "rank"],
        "properties": {
          "project_id": { "type": "string" },
          "reason": { "type": "string", "minLength": 10, "maxLength": 400 },
          "matched_gaps": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "string" } },
          "adaptation": { "type": "string", "minLength": 10, "maxLength": 400 },
          "rank": { "type": "integer", "minimum": 1, "maximum": 3 }
        }
      }
    },
    "milestones": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["week", "title", "deliverable", "talking_point"],
        "properties": {
          "week": { "type": "string", "maxLength": 20 },
          "title": { "type": "string", "minLength": 2, "maxLength": 100 },
          "deliverable": { "type": "string", "minLength": 5, "maxLength": 400 },
          "talking_point": { "type": "string", "minLength": 5, "maxLength": 400 }
        }
      }
    }
  }
}
