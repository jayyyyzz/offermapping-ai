{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offermapping.local/schemas/extractor-output.schema.json",
  "title": "OfferMapping extractor output",
  "type": "object",
  "additionalProperties": false,
  "required": ["job_family", "role", "background_assets", "hard_requirements", "skills"],
  "properties": {
    "job_family": { "enum": ["algorithm", "ai_app_dev", "ai_product", "data"] },
    "role": { "type": "string", "minLength": 1, "maxLength": 80 },
    "background_assets": { "type": "array", "maxItems": 5, "items": { "type": "string", "maxLength": 80 } },
    "hard_requirements": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "jd_quote", "resume_quote", "status"],
        "properties": {
          "type": { "enum": ["education", "major", "years", "certificate", "location", "schedule", "other"] },
          "jd_quote": { "type": "string", "maxLength": 300 },
          "resume_quote": { "type": "string", "maxLength": 300 },
          "status": { "enum": ["met", "unmet", "unknown"] }
        }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "name", "priority", "jd_quote", "resume_quote", "evidence"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z0-9_]+$", "maxLength": 50 },
          "name": { "type": "string", "maxLength": 50 },
          "priority": { "enum": ["must", "nice"] },
          "jd_quote": { "type": "string", "maxLength": 400 },
          "resume_quote": { "type": "string", "maxLength": 400 },
          "evidence": { "enum": ["project-backed", "listed-only", "missing"] }
        }
      }
    }
  }
}

